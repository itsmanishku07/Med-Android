<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.ReportDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/text_primary" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="180dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ═══ 1. HEADER CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <FrameLayout android:layout_width="48dp" android:layout_height="48dp"
                                android:background="@drawable/bg_stat_icon" android:backgroundTint="@color/badge_bg_blue"
                                android:layout_marginEnd="14dp">
                                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_file" app:tint="@color/primary"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvFileName" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-medium" android:ellipsize="middle"
                                    android:singleLine="true" tools:text="Z615.pdf"/>
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                        android:src="@drawable/ic_clock" app:tint="@color/text_tertiary"
                                        android:layout_marginEnd="4dp"/>
                                    <TextView android:id="@+id/tvUploadDate" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" android:textSize="12sp"
                                        android:textColor="@color/text_tertiary"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <!-- Badges Row -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="11sp"
                                android:textStyle="bold" android:letterSpacing="0.03"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                                android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tvSeverity" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="11sp"
                                android:textStyle="bold" android:letterSpacing="0.03"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                                android:layout_marginEnd="8dp" android:visibility="gone"/>
                            <TextView android:id="@+id/tvSpecialty" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="11sp"
                                android:textStyle="bold" android:letterSpacing="0.03"
                                android:background="@drawable/bg_badge"
                                android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                                android:visibility="gone"/>
                        </LinearLayout>
                        <!-- File Info Row -->
                        <LinearLayout android:id="@+id/layoutFileInfo" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:visibility="gone">
                            <TextView android:id="@+id/tvFileType" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:background="@drawable/bg_badge"
                                android:backgroundTint="#F1F5F9" android:textColor="@color/text_secondary"
                                android:textSize="11sp" android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tvFileSize" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:background="@drawable/bg_badge"
                                android:backgroundTint="#F1F5F9" android:textColor="@color/text_secondary"
                                android:textSize="11sp" android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tvAnalyzedAt" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:background="@drawable/bg_badge"
                                android:backgroundTint="#F1F5F9" android:textColor="@color/text_secondary"
                                android:textSize="11sp" android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" android:visibility="gone"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 2. AI SUMMARY CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_blue"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/badge_bg_blue">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="10dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_blue"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_edit"
                                    app:tint="@color/badge_text_blue"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="AI Analysis Summary" android:textSize="15sp"
                                    android:textStyle="bold" android:textColor="@color/badge_text_blue"
                                    android:fontFamily="sans-serif-medium"/>
                                <TextView android:id="@+id/tvModelUsed" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:textSize="11sp"
                                    android:textColor="@color/text_tertiary" android:visibility="gone"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/tvSummary" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textColor="@color/text_primary" android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 3. EXTRACTION INFO CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExtraction"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon" android:backgroundTint="#F0F9FF"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_file"
                                    app:tint="#0284C7"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Text Extraction Info" android:textSize="15sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutExtractionBadges" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical"/>
                        <TextView android:id="@+id/tvExtractionPreview" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:background="@drawable/bg_badge" android:backgroundTint="#F8FAFC"
                            android:padding="12dp" android:textSize="11sp"
                            android:textColor="@color/text_tertiary" android:fontFamily="monospace"
                            android:maxLines="8" android:ellipsize="end" android:visibility="gone"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 4. PATIENT INFO CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPatientInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="16dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_blue"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_admin"
                                    app:tint="@color/badge_text_blue"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Patient Demographics" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutPatientGrid"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 5. DIAGNOSES CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDiagnoses"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_red"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_red"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_alert_circle"
                                    app:tint="@color/badge_text_red"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Clinical Diagnoses" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-medium"/>
                                <TextView android:id="@+id/tvDiagnosesCount" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:textSize="12sp"
                                    android:textColor="@color/text_tertiary"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/tvDiagnoses" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 6. SYMPTOMS CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptoms"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_orange"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_orange"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_clock"
                                    app:tint="@color/badge_text_orange"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reported Symptoms" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvSymptoms" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 7. VITAL SIGNS CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVitals"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_green"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_green"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_check_circle"
                                    app:tint="@color/badge_text_green"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Vital Signs" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <GridLayout android:id="@+id/gridVitals" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:columnCount="2"
                            android:useDefaultMargins="true"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 8. LAB RESULTS CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLabResults"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_blue"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_blue"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_file"
                                    app:tint="@color/badge_text_blue"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Lab Results" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-medium"/>
                                <TextView android:id="@+id/tvLabCount" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:textSize="12sp"
                                    android:textColor="@color/text_tertiary"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutLabItems" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 9. MEDICATIONS CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMedications"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_amber"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_amber"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_pill"
                                    app:tint="@color/badge_text_amber"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Current Medications" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvMedications" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 10. ABNORMAL FINDINGS CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbnormal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_red"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/badge_bg_red">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_red"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_alert_circle"
                                    app:tint="@color/badge_text_red"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Abnormal Findings" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/badge_text_red"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvAbnormal" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/badge_text_red"
                            android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 11. AI CLINICAL SUGGESTIONS ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuggestions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="#CFC4F3"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon" android:backgroundTint="#F3EDFF"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_edit"
                                    app:tint="#7C3AED"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="AI Clinical Suggestions" android:textSize="16sp"
                                    android:textStyle="bold" android:textColor="@color/text_primary"
                                    android:fontFamily="sans-serif-medium"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="AI-powered recommendations" android:textSize="12sp"
                                    android:textColor="@color/text_tertiary"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutSuggestionItems"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 12. SUGGESTED DOCTORS ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuggestedDoctors"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_green"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_green"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_admin"
                                    app:tint="@color/badge_text_green"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Recommended Doctors" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/layoutDoctorItems"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 13. DOCTOR NOTES ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDoctorNotes"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/badge_border_amber"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@color/badge_bg_amber" android:paddingHorizontal="20dp"
                            android:paddingVertical="14dp" android:gravity="center_vertical">
                            <FrameLayout android:layout_width="32dp" android:layout_height="32dp"
                                android:background="@drawable/bg_stat_icon"
                                android:backgroundTint="@color/badge_bg_amber"
                                android:layout_marginEnd="10dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                    android:layout_gravity="center" android:src="@drawable/ic_edit"
                                    app:tint="@color/badge_text_amber"/>
                            </FrameLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Doctor's Notes" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/badge_text_amber"/>
                        </LinearLayout>
                        <TextView android:id="@+id/tvDoctorNotes" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="14sp" android:lineSpacingExtra="3dp" android:padding="20dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ 14. REVIEW FORM (DOCTOR) ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReview"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:visibility="gone"
                    app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/primary"
                    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Add Clinical Review Notes" android:textSize="16sp"
                            android:textStyle="bold" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" android:layout_marginBottom="16dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etReviewNotes" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minLines="4"
                                android:gravity="top|start" android:hint="Enter medical notes..."/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitReview" android:layout_width="match_parent"
                            android:layout_height="52dp" android:layout_marginTop="12dp"
                            app:cornerRadius="12dp" android:textAllCaps="false"
                            android:text="Submit Official Review"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDoctorEdit"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Allow assigned doctor to edit"
                    android:layout_marginBottom="16dp" android:padding="12dp"
                    android:textStyle="bold" android:visibility="gone"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ═══ Sticky Bottom Actions ═══ -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@color/card_bg" android:elevation="8dp"
        android:paddingHorizontal="16dp" android:paddingVertical="12dp">
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="12dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Analyze with AI"
            android:textAllCaps="false" app:cornerRadius="12dp" android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskAI" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="✨ Ask AI Assistant"
            android:textAllCaps="false" app:cornerRadius="12dp"
            app:backgroundTint="#EFF6FF" android:textColor="#1D4ED8"
            android:layout_marginTop="6dp" android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChat" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Chat with Doctor"
            android:textAllCaps="false" app:cornerRadius="12dp"
            app:backgroundTint="@color/badge_text_blue"
            android:layout_marginTop="6dp" android:visibility="gone"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Delete Report"
            android:textAllCaps="false" style="?attr/materialButtonOutlinedStyle"
            app:cornerRadius="12dp" android:textColor="@color/danger"
            app:strokeColor="@color/danger" android:layout_marginTop="6dp"
            android:visibility="gone"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
