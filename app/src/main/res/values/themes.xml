<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MedReportAI" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Light status bar with dark icons — premium feel -->
        <item name="android:statusBarColor">@color/card_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar matches bottom nav -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Bottom nav M3 -->
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView</item>

        <!-- Smooth transitions -->
        <item name="android:windowAnimationStyle">@style/WindowAnimations</item>
    </style>

    <style name="WindowAnimations" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>
    
    <style name="Theme.MedReportAI.Splash" parent="Theme.MedReportAI">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
