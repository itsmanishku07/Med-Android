<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:stateListAnimator="@animator/card_press_animator"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ── Row 1: Icon + File Name + Severity ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_stat_icon"
                android:backgroundTint="@color/badge_bg_blue"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file"
                    app:tint="@color/badge_text_blue" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Blood_Test_Report.pdf"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Oct 14, 2026"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="CRITICAL"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:textColor="@color/badge_text_red"
                android:backgroundTint="@color/badge_bg_red"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Row 2: Patient Name (doctor view) ── -->
        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="50dp"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="Patient: John Doe" />

        <!-- ── Row 3: AI Summary Snippet ── -->
        <LinearLayout
            android:id="@+id/layoutAiSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#F8FAFC"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI SUMMARY"
                android:textStyle="bold"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDiagnosesPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Diagnoses: Hypertension, Elevated Cholesterol"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/layoutAbnormalAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/badge_text_red"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:id="@+id/tvAbnormalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Abnormal findings"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_text_red" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutDoctorAssigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:visibility="visible">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctor assigned"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Row 4: Action Buttons ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:text="View Details"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsultDoctor"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:text="Consult"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                app:strokeColor="@color/danger"
                android:text="Delete"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <!-- Doctor-specific -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptCase"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:text="Accept"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatPatient"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:text="Chat"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArchiveToggle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="8dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:text="Archive"
                android:paddingHorizontal="12dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom separator line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="@color/divider"
        android:layout_marginHorizontal="14dp" />

</com.google.android.material.card.MaterialCardView>
