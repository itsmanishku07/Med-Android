<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvFileName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/on_surface" android:maxLines="2" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="12sp" android:textColor="@color/on_surface_variant" />
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="@color/primary" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tvSeverity" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
